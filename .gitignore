    </div>

    <script src="/app.js"></script>
  </body>
</html>
```

4) public/app.js

```js
const balanceEl = document.getElementById("balance");
const transactionsBody = document.getElementById("transactionsBody");
const amountInput = document.getElementById("amountInput");
const dailyBonusBtn = document.getElementById("dailyBonusBtn");
const depositBtn = document.getElementById("depositBtn");
const withdrawBtn = document.getElementById("withdrawBtn");

async function loadUser() {
  const res = await fetch("/api/user");
  const data = await res.json();
  balanceEl.textContent = "$" + Number(data.balance).toFixed(2);

  if (!data.dailyBonusReady) {
    dailyBonusBtn.disabled = true;
    dailyBonusBtn.textContent = "Bonus Already Claimed";
  } else {
    dailyBonusBtn.disabled = false;
    dailyBonusBtn.textContent = "Claim Daily Bonus";
  }
}

async function loadTransactions() {
  const res = await fetch("/api/transactions");
  const data = await res.json();

  transactionsBody.innerHTML = "";

  data.forEach((tx) => {
    const row = document.createElement("tr");
    row.innerHTML = `
      <td>${tx.type}</td>
      <td>$${Number(tx.amount).toFixed(2)}</td>
      <td class="status">${tx.status}</td>
      <td>${new Date(tx.createdAt).toLocaleString()}</td>
    `;
    transactionsBody.appendChild(row);
  });
}

async function claimBonus() {
  const res = await fetch("/api/daily-bonus", { method: "POST" });
  const data = await res.json();

  if (!res.ok) {
    alert(data.error || "Could not claim daily bonus");
    return;
  }

  alert(data.message);
  loadUser();
  loadTransactions();
}

async function deposit() {
  const amount = Number(amountInput.value);
  const res = await fetch("/api/deposit", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ amount })
  });

  const data = await res.json();
  if (!res.ok) {
    alert(data.error || "Deposit failed");
    return;
  }

  alert(data.message);
  loadUser();
  loadTransactions();
}

async function withdraw() {
  const amount = Number(amountInput.value);
  const res = await fetch("/api/withdraw", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ amount })
  });

  const data = await res.json();
  if (!res.ok) {
    alert(data.error || "Withdrawal failed");
    return;
  }

  alert(data.message);
  loadUser();
  loadTransactions();
}

dailyBonusBtn.addEventListener("click", claimBonus);
depositBtn.addEventListener("click", deposit);
withdrawBtn.addEventListener("click", withdraw);

loadUser();
loadTransactions();
```

Install and run:

```bash
npm install
npm run dev
```

Then open:
- http://localhost:3000

This gives you a clean local casino app MVP with:
- balance
- daily bonus
- instant withdrawal
- no fees
- no holds
- basic transaction feed

