Yes — here’s a clean, runnable starter for a casino-style app with:
- daily bonus system
- no withdrawal fees
- no holds
- balance dashboard
- simple transaction history

This is a lightweight MVP you can run locally with one command.

Project structure:
- package.json
- server.js
- public/index.html
- public/app.js

1) package.json

```json
{
  "name": "casino-daily-bonus-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5"
  }
}
```

2) server.js

```js
import express from "express";
import cors from "cors";
import path from "path";
import { fileURLToPath } from "url";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const app = express();
const port = process.env.PORT || 3000;

app.use(cors());
app.use(express.json());
app.use(express.static(path.join(__dirname, "public")));

const state = {
  user: {
    id: "u_001",
    name: "Player One",
    balance: 245.5,
    dailyBonusClaimedAt: null,
    lastUpdated: new Date().toISOString()
  },
  transactions: [
    {
      id: "t_001",
      type: "deposit",
      amount: 100,
      status: "completed",
      createdAt: new Date().toISOString()
    },
    {
      id: "t_002",
      type: "bonus",
      amount: 35,
      status: "completed",
      createdAt: new Date().toISOString()
    }
  ]
};

function formatMoney(n) {
  return Number(n).toFixed(2);
}

function canClaimDailyBonus() {
  if (!state.user.dailyBonusClaimedAt) return true;
  const last = new Date(state.user.dailyBonusClaimedAt);
  const now = new Date();
  const diffHours = (now - last) / (1000 * 60 * 60);
  return diffHours >= 24;
}

app.get("/api/health", (req, res) => {
  res.json({ ok: true, message: "Casino app is running" });
});

app.get("/api/user", (req, res) => {
  res.json({
    ...state.user,
    balance: formatMoney(state.user.balance),
    dailyBonusReady: canClaimDailyBonus()
  });
});

app.post("/api/deposit", (req, res) => {
  const { amount } = req.body;
  const depositAmount = Number(amount);

  if (!Number.isFinite(depositAmount) || depositAmount <= 0) {
    return res.status(400).json({ error: "Invalid deposit amount" });
  }

  state.user.balance += depositAmount;
  state.transactions.unshift({
    id: `t_${Date.now()}`,
    type: "deposit",
    amount: depositAmount,
    status: "completed",
    createdAt: new Date().toISOString()
  });

  res.json({
    success: true,
    balance: formatMoney(state.user.balance),
    message: "Deposit completed successfully."
  });
});

app.post("/api/withdraw", (req, res) => {
  const { amount } = req.body;
  const withdrawAmount = Number(amount);

  if (!Number.isFinite(withdrawAmount) || withdrawAmount <= 0) {
    return res.status(400).json({ error: "Invalid withdrawal amount" });
  }

  if (withdrawAmount > state.user.balance) {
    return res.status(400).json({ error: "Insufficient balance" });
  }

  // No fees, no holds, instant redemption
  state.user.balance -= withdrawAmount;

  state.transactions.unshift({
    id: `t_${Date.now()}`,
    type: "withdrawal",
    amount: withdrawAmount,
    status: "completed",
    createdAt: new Date().toISOString()
  });

  res.json({
    success: true,
    balance: formatMoney(state.user.balance),
    message: "Withdrawal approved instantly. No fees or holds."
  });
});

app.post("/api/daily-bonus", (req, res) => {
  if (!canClaimDailyBonus()) {
    const last = new Date(state.user.dailyBonusClaimedAt);
    const nextAvailable = new Date(last.getTime() + 24 * 60 * 60 * 1000);

    return res.status(400).json({
      error: "Daily bonus already claimed.",
      nextAvailableAt: nextAvailable.toISOString()
    });
  }

  const bonus = 25;
  state.user.balance += bonus;
  state.user.dailyBonusClaimedAt = new Date().toISOString();

  state.transactions.unshift({
    id: `t_${Date.now()}`,
    type: "bonus",
    amount: bonus,
    status: "completed",
    createdAt: new Date().toISOString()
  });

  res.json({
    success: true,
    bonus,
    balance: formatMoney(state.user.balance),
    message: "Daily bonus added successfully."
  });
});

app.get("/api/transactions", (req, res) => {
  res.json(state.transactions);
});

app.get("*", (req, res) => {
  res.sendFile(path.join(__dirname, "public", "index.html"));
});

app.listen(port, () => {
  console.log(`Casino app running on http://localhost:${port}`);
});
```

3) public/index.html

```html
